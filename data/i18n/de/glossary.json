{
  "terms": {
    "swap (a comparison page)": {
      "de": "Vergleich",
      "avoid": [
        "Swap",
        "Swaps",
        "Tausch"
      ],
      "note": "The page that sets a brand against a cheaper product. Plural: Vergleiche."
    },
    "swap (the cheaper product)": {
      "de": "Alternative",
      "avoid": [],
      "note": "günstige(re) Alternative. The brand side is the Markenprodukt or die Marke."
    },
    "switching": {
      "de": "Wechsel",
      "avoid": [
        "Umstieg"
      ],
      "note": "Verb: wechseln. \"Was der Wechsel spart\"."
    },
    "kit (a brand's set)": {
      "de": "Set",
      "avoid": [
        "Kit",
        "Kits",
        "Bundle",
        "Bundles",
        "Paket"
      ],
      "note": "Marken-Set when it needs the brand; rebuilt: selbst zusammengestellt, nachgebaut."
    },
    "basket (our list for a life moment)": {
      "de": "Einkaufskorb",
      "avoid": [],
      "note": "A store's cart is the Warenkorb; never call our basket a Warenkorb."
    },
    "basket (a store's cart)": {
      "de": "Warenkorb",
      "avoid": []
    },
    "saving": {
      "de": "Ersparnis",
      "avoid": [
        "Einsparung",
        "Einsparungen"
      ],
      "note": "Verb: sparen. \"Du sparst\"."
    },
    "checked": {
      "de": "geprüft",
      "avoid": [
        "überprüft",
        "gecheckt",
        "checken"
      ],
      "note": "Noun: Prüfung. Prices: \"Preise geprüft am …\"."
    },
    "delivery (the cost)": {
      "de": "Versand",
      "avoid": [
        "Lieferkosten",
        "Liefergebühr",
        "Liefergebühren",
        "Zustellung"
      ],
      "note": "Versandkosten, versandkostenfrei, bei Einzelbestellung. \"liefern nach\" for where a store ships to."
    },
    "store (the seller)": {
      "de": "Händler",
      "avoid": [
        "Retailer",
        "Shop",
        "Shops",
        "Shoppreis",
        "Shopseite"
      ],
      "note": "Its website: Onlineshop; a product's page there: Produktseite. Bare \"Shop\" only in a name (Shop Apotheke). Markt only for picking up in a store (im Markt abholen)."
    },
    "aisle": {
      "de": "Kategorie",
      "avoid": [
        "Regalgang"
      ]
    },
