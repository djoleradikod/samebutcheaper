    "evidence": {
      "de": "Belege",
      "avoid": [],
      "note": "Singular Beleg. \"Nachweis\" only in the legal sense (proof that you asked)."
    },
    "same active ingredient": {
      "de": "Gleicher Wirkstoff / wirkstoffgleich",
      "avoid": [
        "identisch",
        "baugleich",
        "genauso wirksam"
      ],
      "note": "Never a claim that a medicine works as well. The leaflet: Packungsbeilage; ask: in der Apotheke."
    },
    "package leaflet": {
      "de": "Packungsbeilage",
      "avoid": [
        "Beipackzettel"
      ],
      "note": "The word § 4 HWG uses: \"Zu Risiken und Nebenwirkungen lesen Sie die Packungsbeilage …\"."
    },
    "medicine": {
      "de": "Arzneimittel",
      "avoid": [
        "Medikament",
        "Medikamente"
      ],
      "note": "Rezeptfrei, apothekenpflichtig, verschreibungspflichtig as the law uses them."
    },
