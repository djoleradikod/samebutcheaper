      "de": "Artikel",
      "avoid": [],
      "note": "1 Artikel, 2 Artikel."
    },
    "pack": {
      "de": "Packung",
      "avoid": [],
      "note": "Packungsgröße; \"Packung mit 24 Tabletten\"; \"20er-Packung\"."
    },
    "unit price": {
      "de": "Grundpreis",
      "avoid": [],
      "note": "As a noun Grundpreis; in a sentence \"pro Einheit\" is fine (\"günstiger pro Einheit\")."
    },
    "store brand, own label": {
      "de": "Eigenmarke",
