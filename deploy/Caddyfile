# Automatic HTTPS (Let's Encrypt) for SITE_DOMAIN. Point your domain's A/AAAA
# records at the server first. www redirects to the bare domain.
{$SITE_DOMAIN} {
	encode zstd gzip
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy web:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
