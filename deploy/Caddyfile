# Automatic HTTPS (Let's Encrypt) for SITE_DOMAIN. Point your domain's A/AAAA
# records at the server first. www redirects to the bare domain.
#
# Behind Cloudflare: uncomment the `servers` block so Caddy trusts Cloudflare's
# forwarded address, and set CLIENT_IP_HEADER=cf-connecting-ip in .env.
{
	# servers {
	# 	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# }
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# The largest thing anyone sends is a 5 MB product photo.
	request_body {
		max_size 6MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:3000 {
		# Take the app out of rotation while it restarts, instead of showing a 502 page mid-deploy.
		health_uri /api/health
		health_interval 10s
		health_timeout 5s
		lb_try_duration 20s
		lb_try_interval 500ms
	}

	log {
		output stdout
		format json
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
