# Copy to .env and fill in.  cp .env.example .env

# Public URL of the site (used for canonical links, sitemap, Open Graph) and the contact address on every page.
# Both are fixed into the pages when the site is BUILT. A server deployed by the Deploy workflow takes them from the
# repository variables SITE_URL and CONTACT_EMAIL instead (docs/deploy.md); set them here to the same values so
# `npm run preflight` checks what the site really uses.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@samebutcheaper.com

# Database (docker compose builds DATABASE_URL from these).
POSTGRES_USER=sbc
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=samebutcheaper
# For `npm run dev` outside Docker:
# DATABASE_URL=postgres://sbc:change-me@localhost:5432/samebutcheaper
# Connections each web process keeps open (default 10). On a serverless host, 1 to 3 (docs/deploy-options.md).
# DB_POOL_MAX=10

# Affiliate programs. Every outbound link goes through /go or /out, which picks
# the best program for the store, adds our click ID as the sub-ID, logs the
# click and redirects. Links still work (untagged) when all of these are empty.
# Full guide: docs/affiliate-playbook.md. Status of each: /admin.
# These are read when the site is BUILT (next.config.ts bakes them in), so rebuild after
# changing them. The site's wording about earning follows them automatically.
#
# Amazon Associates. amazon.com tracking ID:
AMAZON_ASSOCIATE_TAG=
# Other Amazon stores, as domain:tag pairs separated by commas, e.g.
# AMAZON_TAGS=amazon.co.uk:yourtag-21,amazon.ca:yourtag-20,amazon.de:yourtag-21
AMAZON_TAGS=
#
# Network accounts (one each, shared by all their stores):
AWIN_PUBLISHER_ID=
RAKUTEN_SITE_ID=
CJ_PID=
#
# One var per store program, AFF_<PROGRAM ID> (ids in src/lib/affiliate-programs.ts).
# Impact: the program's tracking link from the Impact dashboard.
AFF_WALMART_US=
AFF_TARGET=
# Awin / Rakuten: "1" once approved (uses the known merchant ID) or the merchant ID.
# CJ: "1" once approved.  Partnerize: the camref.
# Any program also takes a full template: https://...?u={url}&sub={click}
# e.g. AFF_BOOTS=1  AFF_SHOPAPOTHEKE=1  AFF_CHEWY=<camref>
#
# Sub-affiliate network for every store without a direct program (Tesco,
# Loblaws, Costco...). Set one; AFFILIATE_FALLBACK picks the order if both.
SKIMLINKS_ID=
SOVRN_KEY=
AFFILIATE_FALLBACK=skimlinks,sovrn
# Shared secret for sale postbacks from networks (/api/postback?key=...).
# Use a long random string.
POSTBACK_SECRET=

# Product check (/check).
# Photo label reading uses Claude. Without a key, barcodes and typed searches
# still work and the photo button explains that label reading is off.
ANTHROPIC_API_KEY=
# Optional: a different Claude model ID for photo reading (the default is set in
# src/app/api/identify/route.ts).
PHOTO_MODEL=
# Optional free key from https://open.fda.gov/apis/authentication/ for a higher
# daily limit on drug label lookups (works without one at lower volume).
OPENFDA_API_KEY=

# Email (newsletter confirmation and unsubscribe). Sign-ups are saved without it, and get their
# confirmation email once it is set. Create a Resend account (resend.com), verify the domain there,
# then set the API key and the sender. MAIL_FROM must be on the verified domain.
RESEND_API_KEY=
MAIL_FROM=SameButCheaper <hello@samebutcheaper.com>
# Optional: where replies go, if not the sender.
MAIL_REPLY_TO=
# Only for tests: a stand-in for Resend's send endpoint. Leave unset.
# RESEND_API_URL=
# The postal address marketing email must carry (US CAN-SPAM; expected in the EU). The weekly letter is held back
# until it is set. Price-watch emails show it too when set.
MAIL_POSTAL_ADDRESS=
# The weekly letter to confirmed readers (src/lib/letter.ts). Off until "on"; look at it first with
# `npm run newsletter:preview` or the test button in /admin.
NEWSLETTER_WEEKLY=
# First weekday it may go out, 1 (Monday) to 7 (Sunday). Default 4, Thursday.
# NEWSLETTER_WEEKDAY=4
# Most letters and price-watch emails one daily run sends; the rest go the next day.
# NEWSLETTER_MAX_PER_RUN=200
# WATCH_MAX_PER_RUN=200
# "Tell me when you add it" answers one daily run sends (src/lib/wanted-answer.ts).
# WISH_MAX_PER_RUN=100
# Legal notice (Impressum) at /impressum, linked from the footer and every email. German law requires it before
# sending email to German readers. Use the owner's real details; nothing is filled in for you. Until the first three
# are set, /impressum says it isn't published (and isn't indexed), /admin flags it, and the weekly letter is held back
# for readers in Germany and Austria. Separate address lines with " | ".
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Optional: shown only when set.
LEGAL_PHONE=
LEGAL_VAT_ID=
# Person responsible for the content (§18 MStV), name and address, if different from the above.
LEGAL_RESPONSIBLE=
# Fills in "Send a test to me" on /admin.
ADMIN_EMAIL=

# /admin dashboard (user "admin"). Leave empty to disable admin. At least 12 characters.
ADMIN_PASSWORD=
# Random string used to hash visitors for unique-click counting (openssl rand -hex 24).
CLICK_HASH_SALT=change-me

# Only when a CDN sits in front and the server can't be reached around it: the header that carries
# the visitor's address. Cloudflare: cf-connecting-ip. Leave empty behind Caddy alone.
CLIENT_IP_HEADER=
# How long details are kept, in days (defaults shown). See the privacy page.
# RETENTION_CLICK_DETAIL_DAYS=180
# RETENTION_LOOKUP_DAYS=365
# RETENTION_REPORT_DAYS=180     ("Something wrong?" reports)
# RETENTION_WANTED_DAYS=400     (counts of searches that found nothing)
# RETENTION_WISH_DAYS=365       ("Tell me when you add it" requests)
# RETENTION_SEND_DAYS=400       (log of emails sent)
# Nightly database backups kept in ./backups.
# BACKUP_KEEP_DAYS=14

# Only used with `docker compose --profile proxy` (Caddy + HTTPS).
SITE_DOMAIN=samebutcheaper.com
WEB_PORT=3000

# ---- Deploy from GitHub (docker-compose.deploy.yml, docs/deploy.md). Only read on a server deployed by the
# ---- Deploy workflow; ignored by `docker compose up` and `npm run dev`. Defaults shown.
# Compose project name: the deploy only ever touches containers of this project.
# SBC_PROJECT=samebutcheaper
# The two ports the site takes turns on; the reverse proxy lists both. Pick two that nothing else uses.
# SBC_BLUE_PORT=3101
# SBC_GREEN_PORT=3102
# Address those ports listen on. 127.0.0.1 unless the proxy runs in a container (then the Docker bridge address,
# usually 172.17.0.1). Never 0.0.0.0: Docker's ports skip the firewall.
# SBC_BIND=127.0.0.1
# Ceilings for each web container and the database, so they can't starve another site on the server.
# SBC_WEB_MEMORY=768m
# SBC_WEB_CPUS=1
# SBC_DB_MEMORY=512m
# 1: a deploy only goes live when nothing on the launch checklist blocks (/api/health?ready=1).
# DEPLOY_REQUIRE_READY=

# ---- Affiliate price feeds (docs/feeds.md). These are NOT read by the site: set them as repository secrets for
# ---- the Price watch workflow (Settings > Secrets and variables > Actions). Listed here so a local run can use them.
# One feed per line: [network:]<retailer>@<MARKET>=<feed URL or file>. network: awin (default), impact, cj, rakuten,
# flexoffers, or generic. A URL may carry user:password@ for Basic auth (Impact: AccountSID:AuthToken).
# PRICE_FEED_URLS=
# Only when a feed's columns differ from the network defaults, or for a generic feed. One line per feed:
# <retailer>@<MARKET>: price=Column; gtin=Column|Other column; link=Tracked link column; name=...; stock=...
# PRICE_FEED_COLUMNS=
# FlexOffers web service key, sent as an apiKey header (unconfirmed: check FlexOffers' API page once approved).
# FLEXOFFERS_API_KEY=
# Rows not updated in this many days are ignored (default 30).
# PRICE_FEED_MAX_AGE_DAYS=30
